# Go Backend — Green-Gate OS API
PORT=8080

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AIS
AISSTREAM_API_KEY=your-aisstream-api-key

# Internal API auth (same as AIS_INGEST_SECRET in frontend)
API_SECRET=your-api-secret

# App
APP_URL=https://africgreen.gov.sl

# Sentry (monitoring) — empty = disabled (no-op, zero overhead)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
