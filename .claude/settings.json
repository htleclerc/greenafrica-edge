{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm list:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx husky:*)",
      "Bash(npx lint-staged:*)",
      "Bash(node -e:*)",
      "Bash(node scripts/:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git -c:*)",
      "Bash(git -C:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(for f:*)",
      "Bash(sed -i:*)",
      "Read(//c/Users/lecle/.claude//**)",
      "Read(//c/Users/lecle/.claude/projects/c--Users-lecle-Workspace-africgreen/memory/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(curl*supabase*apikey*)",
      "Bash(*PGPASSWORD*)",
      "Bash(*service_role*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-use-security.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-use-i18n.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-use-naming.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-use-i18n.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
