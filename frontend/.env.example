# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (for migrations/scripts only)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3300
NEXT_PUBLIC_DEMO_ALLOWED=false

# Go Backend (Fly.io)
NEXT_PUBLIC_BACKEND_URL=https://africgreen-api.fly.dev

# AIS (aisstream.io for live vessel tracking)
AISSTREAM_API_KEY=your-aisstream-api-key
AIS_INGEST_SECRET=shared-secret-with-go-backend

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
CRON_SECRET=any-random-string-for-vercel-cron-auth

# Setup
SETUP_SECRET=change-this-after-first-admin-creation
