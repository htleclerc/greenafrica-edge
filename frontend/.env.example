# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (for migrations/scripts only)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3300
NEXT_PUBLIC_DEMO_ALLOWED=false

# Go Backend (Fly.io)
NEXT_PUBLIC_BACKEND_URL=https://africgreen-api.fly.dev

# AIS (aisstream.io for live vessel tracking)
AISSTREAM_API_KEY=your-aisstream-api-key
AIS_INGEST_SECRET=shared-secret-with-go-backend

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
CRON_SECRET=any-random-string-for-vercel-cron-auth

# Setup
SETUP_SECRET=change-this-after-first-admin-creation

# Feature flags
# MANAGER role visibility in registration form + post-login chooser.
# When false: the role exists in the DB enum + RBAC matrix but is hidden in
# the UI. Existing MANAGER profiles still log in normally — the flag only
# gates the discoverability of the role for new users.
NEXT_PUBLIC_FEATURE_MANAGER_ROLE=false

# Invoice signing — server-side HMAC for tamper-evident pro-forma/invoice URLs.
# Generate with `openssl rand -hex 32`.
INVOICE_SIGNING_SECRET=generate-with-openssl-rand-hex-32

# Carbon tax pro-forma pipeline (Plan 3)
# Shared secret between the proforma-worker pg_cron job (Supabase) and the
# /api/queue/process-proforma route. Must match app_config.queue.worker_secret.
# Generate with `openssl rand -hex 32`.
QUEUE_WORKER_SECRET=generate-with-openssl-rand-hex-32
# Base URL of the Go backend tax calculator (Plan 2).
AFRICGREEN_API_URL=http://127.0.0.1:8080
# Shared secret for Bearer auth against the Go backend.
# Must match the Go backend's API_SECRET env var.
AFRICGREEN_API_SECRET=shared-secret-with-go-backend

# ─── Plan 7B: Shipowner self-service signup ─────────────────────────────────
# reCAPTCHA v3 keys for /owner/register form. Get free pair at
# https://www.google.com/recaptcha/admin. Use v3 (invisible).
# Both keys empty → dev fallback skips verification.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Base URL used in magic-link redirects sent by registerShipowner / approve.
NEXT_PUBLIC_BASE_URL=http://localhost:3300

# Plan 7C: OpenExchangeRates free tier — 1000 requests/month
OPENEXCHANGE_RATES_API_KEY=

# Plan 7D: Stripe — TEST mode in dev/preview, LIVE in production (gated by UK entity confirmation)
STRIPE_SECRET_KEY=sk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
STRIPE_PUBLISHABLE_KEY=pk_test_…              # not strictly required (hosted Checkout), but useful for debug

# Vercel Cron auth (also reused by Plan 7D /api/cron/stripe-reconcile)
# Note: CRON_SECRET already declared above for Resend/email cron — same value powers Stripe reconcile.
